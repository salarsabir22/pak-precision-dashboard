APP_NAME="PAK Precision Tools"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dashboard
DB_USERNAME=root
DB_PASSWORD=

# Must match each storefront INBOX_SITE_KEY. Used by php artisan db:seed.
SITE_KEY_PRECISION=site_pcs_local_dev_key_change_me
SITE_KEY_PKPT=site_pkpt_local_dev_key_change_me
SITE_KEY_INDUS=site_indus_local_dev_key_change_me

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="inbox@localhost"
MAIL_FROM_NAME="${APP_NAME}"
